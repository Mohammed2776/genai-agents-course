    "    providers_utils.gemini_client = lambda: fake                                  # offline: the helper gets our fake list\n",
    "    real_names = providers_utils.list_gemini_models()\n",
    "finally:\n",
    "    providers_utils.gemini_client = real_client                                   # always put the real one back\n",
