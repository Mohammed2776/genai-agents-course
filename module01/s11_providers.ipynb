    "import re\n",
    "import providers_utils\n",
    "from types import SimpleNamespace\n",
    "from providers_utils import _NON_CHAT\n",
    "\n",
    "PRACTICE_IDS = [\"models/gemini-2.5-flash\", \"models/gemini-2.5-flash-image\", \"models/gemini-2.5-flash-lite\",\n",
    "                \"models/gemini-2.5-flash-preview-tts\", \"models/gemini-3-flash-preview\", \"models/gemini-3.5-flash\",\n",
    "                \"models/gemini-flash-latest\", \"models/gemini-omni-1.1-flash\"]   # practice names, not a live list\n",
    "\n",
    "def my_flash_chat_models(ids):\n",
    "    names = [i.removeprefix(\"models/\") for i in ids]                              # drop the \"models/\" prefix\n",
    "    return sorted([n for n in names if \"flash\" in n.lower() and not any(bad in n.lower() for bad in _NON_CHAT)])\n",
    "\n",
    "def my_pick(available):\n",
    "    if \"gemini-flash-latest\" in available:                                        # the alias always points at a current model\n",
    "        return \"gemini-flash-latest\"\n",
    "    versions = []\n",
    "    for n in available:\n",
    "        m = re.fullmatch(r\"gemini-(\\d+(?:\\.\\d+)?)-flash\", n)                      # plain names only: no -lite, no -preview\n",
    "        if m:\n",
    "            versions.append((float(m.group(1)), n))\n",
    "    return max(versions)[1] if versions else None\n",
    "\n",
    "fake = SimpleNamespace(models=SimpleNamespace(list=lambda: [SimpleNamespace(id=i) for i in PRACTICE_IDS]))\n",
