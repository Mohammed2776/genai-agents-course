    "class FakeClient:\n",
    "    \"\"\"Looks like an OpenAI client to ask(), but never touches the network: it records the request.\"\"\"\n",
    "    def __init__(self, reply=\"An EMI is a fixed monthly loan repayment.\"):\n",
    "        self.reply, self.sent = reply, None\n",
    "        self.chat = SimpleNamespace(completions=self)              # so client.chat.completions.create(...) works\n",
    "    def create(self, **kwargs):\n",
    "        self.sent = kwargs                                         # remember exactly what would be sent\n",
    "        usage = SimpleNamespace(prompt_tokens=21, completion_tokens=9, total_tokens=30)   # made-up numbers\n",
    "        return SimpleNamespace(choices=[SimpleNamespace(message=SimpleNamespace(content=self.reply))], usage=usage)\n",
    "\n",
    "def my_ask(client, model, system, user, *, temperature=0.0, max_tokens=200, stop=None):\n",
    "    messages = []\n",
    "    if system:                                                     # \"\" means: no system message at all\n",
    "        messages.append({\"role\": \"system\", \"content\": system})\n",
    "    messages.append({\"role\": \"user\", \"content\": user})\n",
    "    kwargs = dict(model=model, messages=messages, temperature=temperature, max_tokens=max_tokens)\n",
    "    if stop:\n",
    "        kwargs[\"stop\"] = stop                                      # only sent when you ask for it\n",
    "    r = client.chat.completions.create(**kwargs)\n",
    "    return {\"text\": r.choices[0].message.content, \"prompt_tokens\": r.usage.prompt_tokens,\n",
    "            \"completion_tokens\": r.usage.completion_tokens, \"total_tokens\": r.usage.total_tokens}\n",
    "\n",
    "cases = [(\"with system\", dict(system=system, user=user)),\n",
    "         (\"without system\", dict(system=\"\", user=user)),\n",
    "         (\"with stop\", dict(system=\"Answer briefly.\", user=user, max_tokens=50, stop=[\"\\n\"]))]\n",
    "for name, args in cases:\n",
    "    real_fake, my_fake = FakeClient(), FakeClient()\n",
    "    real_out = ask(real_fake, \"any-model\", **args)\n",
    "    mine_out = my_ask(my_fake, \"any-model\", **args)\n",
    "    same = real_fake.sent == my_fake.sent and real_out == mine_out\n",
    "    print(f\"{name:<15} request same: {real_fake.sent == my_fake.sent}   result same: {real_out == mine_out}   ->\",\n",
    "          \"same\" if same else \"DIFFERENT\")\n",
    "    if name == \"without system\":\n",
    "        print(\"   messages sent:\", my_fake.sent[\"messages\"])"
